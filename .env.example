# Template for local development. Copy to .env and fill in real values.
#
#     cp .env.example .env
#
# .env is gitignored and must never be committed. Nothing in this file is a real
# credential; every value below is a placeholder.

# --- Required -----------------------------------------------------------------

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=replace-me

DATABASE_URL=mysql://user:password@localhost:3306/crims

# --- Optional -----------------------------------------------------------------

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# LOG_LEVEL=INFO

# --- Email --------------------------------------------------------------------

# true forces OTP email verification before a new account can sign in.
EMAIL_VERIFICATION_REQUIRED=true

# Transport selection: leave EMAIL_BACKEND unset and it is inferred from which
# credentials are present. Set it explicitly to override that.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

EMAIL_HOST_USER=you@gmail.com

# Gmail: use an App Password from https://myaccount.google.com/apppasswords
# (requires 2-Step Verification). Do NOT put your account password here.
EMAIL_HOST_PASSWORD=

# Alternative XOAUTH2 transport. Prefer the app password above; the refresh
# token expires and requires a browser consent flow to renew.
# GMAIL_OAUTH_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=

# --- Uploads (production) -----------------------------------------------------

# Vercel's filesystem is ephemeral and read-only, so production must point at an
# object store. See "Known blockers" in README.md.
# MEDIA_STORAGE=storages.backends.s3boto3.S3Boto3Storage
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=

# --- Deployment ---------------------------------------------------------------

# Bearer token guarding POST /internal/migrate/. Without it the route refuses
# every request. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# CRON_SECRET=
